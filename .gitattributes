# .gitattributes for agentic-framework releases

# Exclude framework maintenance and repo-specific docs from release archives
/CHANGELOG.md export-ignore
/RELEASING.md export-ignore
/README.md export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore

# Exclude examples (for GitHub repo browsing only, not needed in releases)
/examples export-ignore

# Exclude tool-specific files (framework dogfooding - each project generates its own)
/CLAUDE.md export-ignore
/.cursorrules export-ignore
/.github export-ignore

# Exclude framework development files
/spec export-ignore
/tests export-ignore
/CONTRIBUTIONS.md export-ignore
/CREDITS.md export-ignore
/PRINCIPLES.md export-ignore

# Include only: .agentic/ folder, VERSION, and install.sh
# Users get: .agentic/ (with .agentic/README.md inside for usage docs)

