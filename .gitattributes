# .gitattributes for agentic-framework releases

# Exclude framework maintenance and repo-specific docs from release archives
/CHANGELOG.md export-ignore
/RELEASING.md export-ignore
/README.md export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore

# Exclude examples (for GitHub repo browsing only, not needed in releases)
/examples export-ignore

# Include only: agentic/ folder and VERSION file
# Users get: agentic/ (with agentic/README.md inside for usage docs)

