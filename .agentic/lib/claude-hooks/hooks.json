{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agentic/hooks/claude/PreToolUse.sh",
            "timeout": 1000,
            "description": "v2 artifact enforcement — block code edits when required artifacts are missing"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agentic/hooks/claude/SessionStart.sh",
            "timeout": 5000,
            "description": "Validate environment and load session context"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agentic/hooks/claude/UserPromptSubmit.sh",
            "timeout": 3000,
            "description": "Phase-aware verification (acceptance criteria check)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agentic/hooks/claude/ExitPlanMode.sh",
            "timeout": 5000,
            "description": "Auto-save plan and inject review instructions after plan mode exit"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agentic/hooks/claude/PostToolUseBash.sh",
            "timeout": 2000,
            "description": "Detect gh pr merge bypassing ag merge workflow"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agentic/hooks/claude/PostToolUseCodeEdit.sh",
            "timeout": 2000,
            "description": "Warn if editing code with unapproved DRAFT plan"
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agentic/hooks/claude/PostToolUse.sh",
            "timeout": 2000,
            "description": "Run quick quality checks after code edits"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agentic/hooks/claude/PreCompact.sh",
            "timeout": 10000,
            "description": "Preserve critical state before context compaction"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agentic/hooks/claude/Stop.sh",
            "timeout": 5000,
            "description": "Workflow integrity check before ending session"
          }
        ]
      }
    ]
  }
}

