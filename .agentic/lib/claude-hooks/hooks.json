{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agentic/lib/claude-hooks/PreToolUse.sh",
            "timeout": 3000,
            "description": "Enforcement: block destructive git ops, enforce spec-first for code edits and commits"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agentic/lib/claude-hooks/SessionStart.sh",
            "timeout": 5000,
            "description": "Validate environment and load session context"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agentic/lib/claude-hooks/SessionStart-token-recover.sh",
            "timeout": 5000,
            "description": "Recover unprocessed token-ledger entries from prior session crashes (R-101)"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agentic/lib/claude-hooks/UserPromptSubmit.sh",
            "timeout": 3000,
            "description": "Phase-aware verification (acceptance criteria check)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agentic/lib/hooks/shared/on-plan-mode-exit.sh",
            "timeout": 5000,
            "description": "Auto-save plan and inject review instructions after plan mode exit"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agentic/lib/hooks/shared/on-bash-merge-detect.sh",
            "timeout": 2000,
            "description": "Detect gh pr merge bypassing ag merge workflow"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agentic/lib/hooks/shared/on-code-edit.sh",
            "timeout": 2000,
            "description": "Warn if editing code with unapproved DRAFT plan"
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agentic/lib/claude-hooks/PostToolUse.sh",
            "timeout": 2000,
            "description": "Run quick quality checks after code edits"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agentic/lib/claude-hooks/PreCompact.sh",
            "timeout": 10000,
            "description": "Preserve critical state before context compaction"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agentic/lib/claude-hooks/Stop.sh",
            "timeout": 5000,
            "description": "Enforcement: blocks session stop until ag verify passes (exit 2 = deny)"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.agentic/lib/claude-hooks/Stop-token-emit.sh",
            "timeout": 5000,
            "description": "Emit token-ledger records for the just-completed turn(s) (R-101)"
          }
        ]
      }
    ]
  }
}
