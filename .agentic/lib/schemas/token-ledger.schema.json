{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentic-framework.dev/schemas/token-ledger.schema.json",
  "title": "TokenLedgerEntry",
  "description": "Canonical append-only token-spend record written to .agentic/journal/token-ledger.jsonl. Powers the ag intel report --tokens / --quota views and the TUI quota ring.",
  "type": "object",
  "required": ["ts", "session_id", "model", "tier", "tokens_in", "tokens_out"],
  "additionalProperties": false,
  "properties": {
    "ts": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "tier": {
      "type": "string",
      "enum": ["tier0", "tier1", "tier2", "tier3"]
    },
    "actor": {
      "type": ["string", "null"],
      "maxLength": 128
    },
    "feature": {
      "type": ["string", "null"],
      "pattern": "^(F|DEV|E|NFR)-[0-9]{3,}(\\.[1-9][0-9]*)*$|^$"
    },
    "tokens_in": {
      "type": "integer",
      "minimum": 0
    },
    "tokens_out": {
      "type": "integer",
      "minimum": 0
    },
    "cache_read_tokens": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "cache_write_tokens": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "cost_usd": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "delegation_id": {
      "type": ["string", "null"],
      "maxLength": 128
    }
  }
}
