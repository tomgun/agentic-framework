{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentic-framework.dev/schemas/delegation.schema.json",
  "title": "DelegationEvent",
  "description": "Canonical append-only delegation record written to .agentic/journal/delegation.jsonl. Captures every Tier 2 / Tier 3 worker invocation with cost and outcome.",
  "type": "object",
  "required": ["ts", "session_id", "delegation_id", "tier", "model", "target", "verdict", "actor"],
  "additionalProperties": false,
  "properties": {
    "ts": {
      "type": "string",
      "description": "ISO8601 UTC timestamp with trailing Z.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "delegation_id": {
      "type": "string",
      "description": "Unique id for this invocation; used to correlate dispatch with completion.",
      "minLength": 1,
      "maxLength": 128
    },
    "tier": {
      "type": "string",
      "enum": ["tier2", "tier3"]
    },
    "model": {
      "type": "string",
      "description": "Model identifier (e.g., claude-haiku-4-5, claude-sonnet-4-6, claude-opus-4-7).",
      "minLength": 1,
      "maxLength": 128
    },
    "target": {
      "type": "string",
      "description": "What was delegated (plan, diff, spec, ac, refactor, verify, ...).",
      "minLength": 1,
      "maxLength": 128
    },
    "feature": {
      "type": ["string", "null"],
      "pattern": "^(F|DEV|E|NFR)-[0-9]{3,}(\\.[1-9][0-9]*)*$|^$"
    },
    "verdict": {
      "type": "string",
      "enum": ["approve", "request_changes", "escalate", "in_progress", "error"]
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "tokens_in": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "tokens_out": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "cost_usd": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "wall_time_ms": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "summary": {
      "type": ["string", "null"],
      "maxLength": 4096
    },
    "_truncated": {
      "type": "boolean"
    }
  }
}
