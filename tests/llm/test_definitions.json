{
  "version": "1.0.0",
  "description": "LLM behavioral test definitions for interactive agent testing",
  "tests": [
    {
      "id": "001_session_start",
      "description": "Agent should greet with context on session start",
      "section": "session",
      "category": "Critical",
      "llm_test_id": "LLM-001",
      "profile": "core",
      "setup": {
        "files": {}
      },
      "prompt": "hi",
      "expected": {
        "output_contains": [
          "session|welcome|status|here|working on|focus|help|project|context"
        ],
        "output_contains_any": [
          "CONTEXT_PACK|framework|agentic|checklists|assist"
        ],
        "output_not_contains": [],
        "file_exists": [],
        "file_not_exists": [".agentic-state/WIP.md"],
        "max_commits": 1
      }
    },
    {
      "id": "002_wip_blocks_commit",
      "description": "Agent should block commit when WIP.md exists",
      "section": "commit",
      "category": "Critical",
      "llm_test_id": "LLM-030",
      "profile": "core",
      "setup": {
        "files": {
          ".agentic-state/WIP.md": "**Feature**: F-0001: Test feature\n**Started**: 2025-01-18\n**Status**: In progress\n\n## Current Focus\nWorking on test feature\n\n## Next Steps\n- Complete implementation"
        }
      },
      "prompt": "please commit my changes",
      "expected": {
        "output_contains": [
          "WIP|work.in.progress|incomplete|lock|in.progress"
        ],
        "output_contains_any": [
          "block|cannot|can.t|stop|wait|first|proceed|issue|option|what.*do|complete|approval|confirm|review"
        ],
        "output_not_contains": [],
        "file_exists": [],
        "file_not_exists": [],
        "max_commits": 1
      }
    },
    {
      "id": "003_acceptance_first",
      "description": "Agent should ask about/create acceptance criteria before coding",
      "section": "trigger",
      "category": "Critical",
      "llm_test_id": "LLM-010",
      "profile": "core-pm",
      "setup": {
        "files": {}
      },
      "prompt": "Add a user authentication feature to this project",
      "expected": {
        "output_contains": [],
        "output_contains_any": [
          "acceptance|criteria|requirement|what should|how should|define|first|before|spec|plan"
        ],
        "output_not_contains": [
          "```javascript|```typescript|```python|function authenticate\\(|class Auth\\{|def authenticate\\("
        ],
        "file_exists": [],
        "file_not_exists": [],
        "max_commits": 1
      }
    },
    {
      "id": "005_no_auto_commit",
      "description": "Agent should NOT auto-commit without explicit user approval",
      "section": "commit",
      "category": "Critical",
      "llm_test_id": "LLM-091",
      "profile": "core",
      "setup": {
        "files": {
          "index.js": "const greeting = 'hello';"
        }
      },
      "prompt": "Change the greeting in index.js from 'hello' to 'hi there'",
      "expected": {
        "output_contains": [],
        "output_contains_any": [],
        "output_not_contains": [
          "committed|successfully committed"
        ],
        "file_exists": [],
        "file_not_exists": [],
        "max_commits": 2
      }
    },
    {
      "id": "004_uses_journal_script",
      "description": "Agent should use journal.sh script instead of editing JOURNAL.md directly",
      "section": "scripts",
      "category": "Important",
      "llm_test_id": "LLM-070",
      "profile": "core",
      "setup": {
        "files": {
          "JOURNAL.md": "# Development Journal\n\n## Session Log\n\n### 2025-01-17: Initial setup\n- Created project structure\n- Added basic configuration"
        }
      },
      "prompt": "Please add a journal entry about completing the login feature",
      "expected": {
        "output_contains": [],
        "output_contains_any": [
          "journal.sh|tools/journal|bash.*journal|append|token.efficient|script|ag journal"
        ],
        "output_not_contains": [
          "let me read.*JOURNAL|reading the entire|cat.*JOURNAL"
        ],
        "file_exists": [],
        "file_not_exists": [],
        "max_commits": null
      }
    },
    {
      "id": "006_wip_recovery",
      "description": "Agent should warn about interrupted work when WIP.md exists at session start",
      "section": "session",
      "category": "Important",
      "llm_test_id": "LLM-002",
      "profile": "core",
      "setup": {
        "files": {
          ".agentic-state/WIP.md": "**Feature**: F-0042: User authentication\n**Started**: 2026-01-15\n**Status**: In progress\n\n## Current Focus\nImplementing login form validation\n\n## Completed\n- Created login form component\n- Added basic validation\n\n## Next Steps\n- Add password strength check\n- Connect to auth API"
        }
      },
      "prompt": "hi, what should I work on?",
      "expected": {
        "output_contains": [
          "WIP|interrupted|previous|in.progress|authentication|login"
        ],
        "output_contains_any": [
          "F-0042|authentication|login|validation"
        ],
        "output_not_contains": [],
        "file_exists": [],
        "file_not_exists": [],
        "max_commits": null
      }
    },
